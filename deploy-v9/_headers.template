/tiles/*
  Access-Control-Allow-Origin: *
  Access-Control-Expose-Headers: Content-Length, ETag
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/webp

/transparent.webp
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/webp

/catalog/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/json; charset=utf-8
